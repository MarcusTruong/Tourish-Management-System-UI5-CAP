<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Dialog
        id="supplierPDFDialog"
        title="{pdfView>/supplierName}"
        contentWidth="90%"
        contentHeight="90vh"
        resizable="true"
        draggable="true"
        afterClose=".onPDFDialogClose">
        
        <content>
            <VBox width="100%" height="100%">
                <!-- Toolbar with supplier info -->
                <Toolbar id="_IDGenToolbar8">
                    <Title text="Supplier Information" level="H3" />
                    <ToolbarSpacer />
                    <Text text="ID: {pdfView>/supplierID}" />
                </Toolbar>
                
                <!-- PDF Content Area -->
                <ScrollContainer
                    width="100%"
                    height="100%"
                    vertical="true"
                    horizontal="false">
                    
                    <VBox class="sapUiMediumMargin">
                        <!-- Header Section -->
                        <VBox class="sapUiSmallMarginBottom">
                            <Title text="{pdfView>/supplierName}" level="H2" />
                            <Text text="Supplier Details Report" class="sapUiTinyMarginTop" />
                        </VBox>
                        
                        <!-- Basic Information -->
                        <Panel headerText="Basic Information" class="sapUiSmallMarginBottom">
                            <content>
                                <form:SimpleForm
                                    xmlns:form="sap.ui.layout.form"
                                    layout="ResponsiveGridLayout"
                                    labelSpanXL="4"
                                    labelSpanL="4"
                                    labelSpanM="4"
                                    labelSpanS="12"
                                    emptySpanXL="0"
                                    emptySpanL="0"
                                    emptySpanM="0"
                                    emptySpanS="0"
                                    columnsXL="2"
                                    columnsL="2"
                                    columnsM="1">
                                    <form:content>
                                        <Label text="Supplier ID" />
                                        <Text text="{pdfView>/supplierID}" />
                                        
                                        <Label text="Supplier Name" />
                                        <Text text="{pdfView>/supplierName}" />
                                        
                                        <Label text="Address" />
                                        <Text text="{pdfView>/address}" />
                                        
                                        <Label text="Phone" />
                                        <Text text="{pdfView>/phone}" />
                                        
                                        <Label text="Email" />
                                        <Text text="{pdfView>/email}" />
                                    </form:content>
                                </form:SimpleForm>
                            </content>
                        </Panel>
                        
                        <!-- Services Section -->
                        <Panel headerText="Services" class="sapUiSmallMarginBottom">
                            <content>
                                <Table
                                    items="{pdfView>/services}"
                                    growing="true"
                                    growingThreshold="10">
                                    <columns>
                                        <Column>
                                            <Text text="Service Name" />
                                        </Column>
                                        <Column>
                                            <Text text="Type" />
                                        </Column>
                                        <Column>
                                            <Text text="Description" />
                                        </Column>
                                        <Column hAlign="End">
                                            <Text text="Price" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{pdfView>ServiceName}" />
                                                <Text text="{pdfView>ServiceType}" />
                                                <Text text="{pdfView>Description}" />
                                                <ObjectNumber
                                                    number="{pdfView>Price}"
                                                    unit="USD" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </content>
                        </Panel>
                        
                        <!-- Debts Section -->
                        <Panel headerText="Debts Summary" class="sapUiSmallMarginBottom">
                            <content>
                                <VBox>
                                    <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                        <Label text="Total Debt:" />
                                        <ObjectNumber
                                            number="{pdfView>/debtStatistics/totalDebt}"
                                            unit="USD"
                                            state="Information" />
                                    </HBox>
                                    <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                        <Label text="Pending Debt:" />
                                        <ObjectNumber
                                            number="{pdfView>/debtStatistics/pendingDebt}"
                                            unit="USD"
                                            state="Warning" />
                                    </HBox>
                                    <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                        <Label text="Completed Debt:" />
                                        <ObjectNumber
                                            number="{pdfView>/debtStatistics/completedDebt}"
                                            unit="USD"
                                            state="Success" />
                                    </HBox>
                                </VBox>
                                
                                <Table
                                    items="{pdfView>/debts}"
                                    growing="true"
                                    growingThreshold="10"
                                    class="sapUiSmallMarginTop">
                                    <columns>
                                        <Column>
                                            <Text text="Amount" />
                                        </Column>
                                        <Column>
                                            <Text text="Due Date" />
                                        </Column>
                                        <Column>
                                            <Text text="Status" />
                                        </Column>
                                        <Column>
                                            <Text text="Description" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <ObjectNumber
                                                    number="{pdfView>Amount}"
                                                    unit="USD" />
                                                <Text text="{
                                                    path: 'pdfView>DueDate',
                                                    type: 'sap.ui.model.type.Date',
                                                    formatOptions: {
                                                        pattern: 'dd/MM/yyyy'
                                                    }
                                                }" />
                                                <ObjectStatus
                                                    text="{pdfView>Status}"
                                                    state="{
                                                        path: 'pdfView>Status',
                                                        formatter: '.formatDebtState'
                                                    }" />
                                                <Text text="{pdfView>Description}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </content>
                        </Panel>
                        
                        <!-- Footer Info -->
                        <VBox class="sapUiSmallMarginTop">
                            <Text text="Generated: {pdfView>/generatedDate}" />
                            <Text text="Report ID: {pdfView>/reportID}" class="sapUiTinyMarginTop" />
                        </VBox>
                    </VBox>
                </ScrollContainer>
            </VBox>
        </content>
        
        <beginButton>
            <Button
                text="Download PDF"
                type="Emphasized"
                press=".onDownloadPDF" />
        </beginButton>
        
        <buttons>
            <Button
                text="Print"
                press=".onPrintPDF" />
            <Button
                text="Email"
                press=".onEmailPDF" />
            <Button
                text="Close"
                press=".onClosePDFDialog" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>